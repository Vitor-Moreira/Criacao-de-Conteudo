// Prisma schema — Plataforma de Inteligência de Conteúdo
// docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────
// Auth.js (NextAuth) — modelos exigidos pelo Prisma Adapter
// ─────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────
// Multi-tenant core
// ─────────────────────────────────────────────────────

enum Role {
  OWNER
  MEMBER
  CLIENT
}

model Organization {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  monthlyBudgetCents Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  users               User[]
  clients             Client[]
  referenceProfiles   ReferenceProfile[]
  contentPosts        ContentPost[]
  contentIdeas        ContentIdea[]
  marketResearches    MarketResearch[]
  creatorDiscoveries  CreatorDiscovery[]
  contentImprovements ContentImprovement[]
  collections         Collection[]
  tags                Tag[]
  usageLogs           UsageLog[]
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  password       String? // hash — só usado se não vier de um OAuth provider
  emailVerified  DateTime?
  image          String?
  role           Role      @default(MEMBER)
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  accounts            Account[]
  sessions            Session[]
  clientAccess        ClientAccess[]
  contentIdeas        ContentIdea[]        @relation("IdeaCreatedBy")
  generatedAssets     GeneratedAsset[]     @relation("AssetCreatedBy")
  collections         Collection[]         @relation("CollectionCreatedBy")
  contentImprovements ContentImprovement[] @relation("ContentImprovementCreatedBy")

  @@index([organizationId])
}

/// Permissão granular: qual usuário enxerga/edita qual cliente.
/// Usado principalmente para role = CLIENT (acesso restrito) e MEMBER com acesso limitado.
model ClientAccess {
  id       String  @id @default(cuid())
  userId   String
  clientId String
  canEdit  Boolean @default(false)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
}

// ─────────────────────────────────────────────────────
// Cliente + base de conhecimento
// ─────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  INACTIVE
}

model Client {
  id                   String       @id @default(cuid())
  organizationId       String
  name                 String
  segment              String?
  businessSummary      String?      @db.Text
  targetAudience       String?      @db.Text
  toneOfVoice          String?      @db.Text
  contentPillars       String[]     @default([])
  socialLinks          Json?
  brandColors          String[]     @default([])
  approvedCopyExamples Json?
  restrictions         String[]     @default([])
  status               ClientStatus @default(ACTIVE)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  knowledgeItems      ClientKnowledgeItem[]
  referenceProfiles   ReferenceProfile[]
  contentIdeas        ContentIdea[]
  generatedAssets     GeneratedAsset[]
  marketResearches    MarketResearch[]
  creatorDiscoveries  CreatorDiscovery[]
  contentImprovements ContentImprovement[]
  collections         Collection[]
  clientAccess        ClientAccess[]

  @@index([organizationId])
}

enum KnowledgeItemType {
  DOCUMENT
  BRIEFING
  PERSONA
  GLOSSARY
  OTHER
}

model ClientKnowledgeItem {
  id        String            @id @default(cuid())
  clientId  String
  type      KnowledgeItemType
  title     String
  content   String?           @db.Text
  fileUrl   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

// ─────────────────────────────────────────────────────
// Monitoramento de perfis de referência
// ─────────────────────────────────────────────────────

enum SocialNetwork {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  LINKEDIN
}

enum ScrapeFrequency {
  MANUAL
  DAILY
  WEEKLY
}

model ReferenceProfile {
  id              String          @id @default(cuid())
  organizationId  String
  clientId        String?
  network         SocialNetwork
  handle          String
  url             String
  category        String?
  scrapeFrequency ScrapeFrequency @default(MANUAL)
  lastScrapedAt   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  scrapeJobs   ScrapeJob[]
  contentPosts ContentPost[]

  @@unique([organizationId, network, handle])
  @@index([organizationId])
  @@index([clientId])
}

enum ScrapeJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

model ScrapeJob {
  id                 String          @id @default(cuid())
  referenceProfileId String
  status             ScrapeJobStatus @default(PENDING)
  apifyRunId         String?
  postsCollected     Int             @default(0)
  errorMessage       String?         @db.Text
  startedAt          DateTime?
  finishedAt         DateTime?
  createdAt          DateTime        @default(now())

  referenceProfile ReferenceProfile @relation(fields: [referenceProfileId], references: [id], onDelete: Cascade)

  @@index([referenceProfileId])
  @@index([status])
}

// ─────────────────────────────────────────────────────
// Conteúdo capturado
// ─────────────────────────────────────────────────────

enum ContentFormat {
  VIDEO_SHORT
  VIDEO_LONG
  IMAGE
  CAROUSEL
  TEXT
}

model ContentPost {
  id                 String        @id @default(cuid())
  organizationId     String
  referenceProfileId String?
  network            SocialNetwork
  externalId         String
  authorHandle       String
  authorFollowers    Int?
  caption            String?       @db.Text
  mediaUrls          Json?
  permalink          String?
  format             ContentFormat
  likes              Int           @default(0)
  comments           Int           @default(0)
  shares             Int           @default(0)
  views              Int?
  /// Engajamento normalizado: (likes+comments+shares) / authorFollowers.
  /// Calculado na coleta para permitir comparar contas de tamanhos diferentes.
  engagementRate     Float         @default(0)
  publishedAt        DateTime?
  collectedAt        DateTime      @default(now())

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referenceProfile ReferenceProfile? @relation(fields: [referenceProfileId], references: [id], onDelete: SetNull)

  tags            PostTag[]
  sourceForIdeas  ContentIdeaSourcePost[]
  collectionItems CollectionItem[]

  @@unique([network, externalId])
  @@index([organizationId])
  @@index([engagementRate])
  @@index([publishedAt])
}

// ─────────────────────────────────────────────────────
// Ideias e geração de IA
// ─────────────────────────────────────────────────────

enum CalendarStatus {
  IDEA
  SCRIPT_READY
  IN_PRODUCTION
  PUBLISHED
}

model ContentIdea {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String?
  createdById    String
  title          String
  description    String?        @db.Text
  theme          String?
  status         CalendarStatus @default(IDEA)
  scheduledDate  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("IdeaCreatedBy", fields: [createdById], references: [id])

  sourcePosts     ContentIdeaSourcePost[]
  generatedAssets GeneratedAsset[]
  tags            IdeaTag[]
  collectionItems CollectionItem[]

  @@index([organizationId])
  @@index([clientId])
}

model ContentIdeaSourcePost {
  ideaId String
  postId String

  idea ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([ideaId, postId])
}

enum GeneratedAssetType {
  SCRIPT
  IMAGE_CONCEPT
  COPY
  HOOK_VARIATIONS
}

model GeneratedAsset {
  id                    String             @id @default(cuid())
  contentIdeaId         String
  clientId              String?
  type                  GeneratedAssetType
  content               String             @db.Text
  version               Int                @default(1)
  promptUsed            String?            @db.Text
  brandFitScore         Int?
  brandFitJustification String?            @db.Text
  createdById           String
  createdAt             DateTime           @default(now())

  contentIdea ContentIdea @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)
  client      Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("AssetCreatedBy", fields: [createdById], references: [id])

  @@index([contentIdeaId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────
// Pesquisa de mercado
// ─────────────────────────────────────────────────────

model MarketResearch {
  id                String   @id @default(cuid())
  organizationId    String
  clientId          String?
  theme             String
  summary           String   @db.Text
  trendingFormats   Json?
  recurringHooks    Json?
  referenceAccounts Json?
  sources           Json?
  createdAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────
// Descoberta de criadores (busca de perfis relevantes por tema via IA)
// ─────────────────────────────────────────────────────

model CreatorDiscovery {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  theme          String
  /// Array de { handle, network, url, followersEstimate, note }, gerado via Claude + busca na web.
  results        Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────
// Melhoria de conteúdo (upload de texto/arquivo + sugestões da IA)
// ─────────────────────────────────────────────────────

enum ContentImprovementSourceType {
  TEXT
  PDF
  DOCX
  XLSX
}

model ContentImprovement {
  id              String                       @id @default(cuid())
  organizationId  String
  clientId        String?
  title           String
  sourceType      ContentImprovementSourceType
  originalFileUrl String?
  originalText    String?                      @db.Text
  analysis        String?                      @db.Text
  improvedText    String?                      @db.Text
  resultFileUrl   String?
  errorMessage    String?                      @db.Text
  createdById     String
  createdAt       DateTime                     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("ContentImprovementCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([clientId])
}

// ─────────────────────────────────────────────────────
// Coleções / favoritos / tags
// ─────────────────────────────────────────────────────

model Collection {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String?
  name           String
  createdById    String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("CollectionCreatedBy", fields: [createdById], references: [id])

  items CollectionItem[]

  @@index([organizationId])
}

model CollectionItem {
  id            String   @id @default(cuid())
  collectionId  String
  contentPostId String?
  contentIdeaId String?
  addedAt       DateTime @default(now())

  collection  Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  contentPost ContentPost? @relation(fields: [contentPostId], references: [id], onDelete: Cascade)
  contentIdea ContentIdea? @relation(fields: [contentIdeaId], references: [id], onDelete: Cascade)

  @@index([collectionId])
}

model Tag {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  color          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  posts        PostTag[]
  ideas        IdeaTag[]

  @@unique([organizationId, name])
}

model PostTag {
  postId String
  tagId  String

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model IdeaTag {
  ideaId String
  tagId  String

  idea ContentIdea @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  tag  Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ideaId, tagId])
}

// ─────────────────────────────────────────────────────
// Controle de custo (Apify / Claude)
// ─────────────────────────────────────────────────────

enum UsageType {
  APIFY_SCRAPE
  CLAUDE_GENERATION
  WEB_SEARCH
}

model UsageLog {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  type           UsageType
  costCents      Int?
  tokensUsed     Int?
  metadata       Json?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
